{
    "name": "effectconnect/marketplaces-plugin-m2",
    "description": "EffectConnect Marketplaces Magento 2 plugin",
    "type": "magento2-module",
    "license": "proprietary",
    "version": "1.0.87",
    "authors": [
        {
            "name": "Koek&Peer",
            "email": "info@koekenpeer.nl",
            "homepage": "https://www.koekenpeer.nl/"
        },
        {
            "name": "EffectConnect",
            "email": "info@effectconnect.com",
            "homepage": "https://www.effectconnect.com/"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-intl": "*",
        "ext-libxml": "*",
        "php": "~7.1.3||~7.2||~7.3||~7.4||~8.0||~8.1||~8.2||~8.3",
        "magento/framework": "^102.0||^103.0",
        "effectconnect/php-sdk": "^3.2.8",
        "myclabs/php-enum": "^1.7",
        "dragonmantank/cron-expression": "^3.0",
        "laminas/laminas-filter": "^2.17"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "EffectConnect\\Marketplaces\\": "./"
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
